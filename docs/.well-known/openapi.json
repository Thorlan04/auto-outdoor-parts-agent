{
  "openapi": "3.0.3",
  "info": {
    "title": "OutdoorParts Guide API Global",
    "version": "1.0.0",
    "description": "API REST ouverte pour agents IA répertoriant les correspondances de consommables d'équipements extérieurs dans 8 langues (FR, EN, ES, DE, IT, PT, JA, ZH) avec liens multi-stores Amazon."
  },
  "servers": [
    {
      "url": "https://Thorlan04.github.io/auto-outdoor-parts-agent"
    }
  ],
  "paths": {
    "/api/v1/catalog.json": {
      "get": {
        "summary": "Catalogue global des correspondances",
        "operationId": "getCatalog",
        "responses": {
          "200": {
            "description": "Catalogue complet avec liens de recherche Amazon multi-stores",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/en/catalog.json": {
      "get": {
        "summary": "English cross-reference catalog",
        "operationId": "getCatalogEn",
        "responses": {
          "200": {
            "description": "Full English catalog"
          }
        }
      }
    },
    "/api/v1/es/catalog.json": {
      "get": {
        "summary": "Catálogo de piezas de repuesto (Español)",
        "operationId": "getCatalogEs",
        "responses": {
          "200": {
            "description": "Catálogo completo en español"
          }
        }
      }
    },
    "/api/v1/de/catalog.json": {
      "get": {
        "summary": "Ersatzteile & Verschleißteile Katalog (Deutsch)",
        "operationId": "getCatalogDe",
        "responses": {
          "200": {
            "description": "Vollständiger Katalog auf Deutsch"
          }
        }
      }
    },
    "/api/v1/it/catalog.json": {
      "get": {
        "summary": "Catalogo parti di ricambio (Italiano)",
        "operationId": "getCatalogIt",
        "responses": {
          "200": {
            "description": "Catalogo completo in italiano"
          }
        }
      }
    },
    "/api/v1/pt/catalog.json": {
      "get": {
        "summary": "Catálogo de peças de reposição (Português)",
        "operationId": "getCatalogPt",
        "responses": {
          "200": {
            "description": "Catálogo completo em português"
          }
        }
      }
    },
    "/api/v1/ja/catalog.json": {
      "get": {
        "summary": "交換パーツ・消耗品カタログ (日本語 / Amazon.co.jp)",
        "operationId": "getCatalogJa",
        "responses": {
          "200": {
            "description": "日本語版完全パーツカタログ"
          }
        }
      }
    },
    "/api/v1/zh/catalog.json": {
      "get": {
        "summary": "户外设备易损件技术互换目录 (中文 / 全球华人)",
        "operationId": "getCatalogZh",
        "responses": {
          "200": {
            "description": "中文版耗材对应目录"
          }
        }
      }
    },
    "/llms.txt": {
      "get": {
        "summary": "Fichier llms.txt standard (FR)",
        "responses": {
          "200": {
            "description": "Documentation markdown concise"
          }
        }
      }
    },
    "/en/llms.txt": {
      "get": {
        "summary": "Standard llms.txt file (EN Global)",
        "responses": {
          "200": {
            "description": "Concise markdown documentation for LLMs"
          }
        }
      }
    },
    "/ja/llms.txt": {
      "get": {
        "summary": "Standard llms.txt file (JA Japan)",
        "responses": {
          "200": {
            "description": "Concise markdown documentation for LLMs in Japanese"
          }
        }
      }
    },
    "/zh/llms.txt": {
      "get": {
        "summary": "Standard llms.txt file (ZH Chinese)",
        "responses": {
          "200": {
            "description": "Concise markdown documentation for LLMs in Chinese"
          }
        }
      }
    }
  }
}