# ==============================================================================
# Configuration auto-outdoor-parts-agent
# Remplir les valeurs réelles dans un fichier .env (hors dépôt git)
# ==============================================================================

# Clé API Google Gemini (AI Studio - https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Identifiant Partenaire Amazon FR (ex: votretag-21)
# Les liens générés n'utilisent JAMAIS d'ASIN en dur et effectuent une recherche
# infaillible sans erreur 404 : https://www.amazon.fr/s?k=...&tag=...
AMAZON_PARTNER_TAG=outdoorparts-21

# URL publique racine du site (GitHub Pages ou nom de domaine personnalisé)
SITE_BASE_URL=https://Thorlan04.github.io/auto-outdoor-parts-agent

# Mentions légales & Conformité RGPD / LCEN / DGCCRF (Micro-Entreprise)
EDITOR_NAME=Alexandre Martin
EDITOR_SIRET=91234567800012
EDITOR_ADDRESS=12 rue de la Paix, 75002 Paris, France
EDITOR_EMAIL=contact@outdoorparts-guide.fr
